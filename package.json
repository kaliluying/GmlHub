{
  "name": "gmlhub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup:one-ip": "pnpm --dir modules/one-ip install --frozen-lockfile --ignore-scripts",
    "postinstall": "pnpm run setup:one-ip",
    "build": "pnpm --dir modules/one-ip run build && vite build",
    "test:one-ip": "pnpm --dir modules/one-ip test",
    "worker:dev": "pnpm --dir modules/one-ip exec wrangler dev --config ../../server/wrangler.dev.toml --ip 127.0.0.1 --port 8787",
    "worker:check": "pnpm --dir modules/one-ip exec wrangler deploy --config ../../wrangler.toml --dry-run --outdir .worker-check",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:run": "vitest run",
    "test:one": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.1",
    "gsap": "^3.15.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.24",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
